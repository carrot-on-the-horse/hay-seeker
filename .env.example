# Copy this file to .env. Hay Seeker finds the nearest .env in the current
# directory or its parents. Exported process variables take precedence over
# this file, and command-line arguments take precedence over both.
#
# `hay-mcp` shares the backend, embedding, database, corpus, and Elasticsearch
# settings. Embedding choices are: none, local-onnx, local-static, gemini,
# open-ai, voyage, and cloudflare-workers-ai.
COTH_HAY_SEEKER_BACKEND=duckdb
# local-static is the zero-setup default: no credentials, and the pinned
# 31 MiB Potion Code 16M v2 bundle is provisioned on first use. Use none for
# lexical-only search.
COTH_HAY_SEEKER_EMBEDDINGS=local-static
# Unset, the index resolves to <git-root>/.hay-seeker/index.duckdb, so any
# subdirectory of a repository uses the one index. Setting it explicitly also
# opts out of building it on demand unless AUTO_INDEX below is `always`.
# COTH_HAY_SEEKER_DATABASE=.hay-seeker/index.duckdb
# What `hay search` does when the repository has no index yet: ask (offer it to
# a person at a terminal, fail closed otherwise), always (build it without
# asking; what CI opts in with), or never. CI is never prompted regardless.
COTH_HAY_SEEKER_AUTO_INDEX=ask
# Unset, `hay index` indexes the Git repository containing the current
# directory, or that directory itself outside a repository. Choose at most one:
# COTH_HAY_SEEKER_REPOSITORY=/absolute/path/to/repository
# COTH_HAY_SEEKER_CORPUS=evals/corpus.jsonl
# COTH_HAY_SEEKER_CHECKPOINT=.hay-seeker/index.checkpoint.json
COTH_HAY_SEEKER_STALL_TIMEOUT_SECONDS=600
COTH_HAY_SEEKER_PROGRESS_INTERVAL_SECONDS=5
COTH_HAY_SEEKER_ELASTICSEARCH_ENDPOINT=http://127.0.0.1:9200
COTH_HAY_SEEKER_ELASTICSEARCH_INDEX=hay-seeker
COTH_HAY_SEEKER_TOP_K=10
COTH_HAY_SEEKER_CANDIDATE_LIMIT=50
# COTH_HAY_SEEKER_QUERY=where is manifest compatibility validated?

# Automatic provisioning for local-static. Downloads are checksum-pinned, so a
# mirror can change where bytes come from but not which bytes are accepted.
# Set this to false for an air-gapped install; pair it with
# COTH_HAY_SEEKER_LOCAL_STATIC_MODEL_DIR below.
COTH_HAY_SEEKER_DOWNLOAD_MODELS=true
# Defaults to the per-user cache directory for this platform.
# COTH_HAY_SEEKER_MODEL_CACHE_DIR=
# Defaults to https://huggingface.co.
# COTH_HAY_SEEKER_MODEL_BASE_URL=

# Fully offline ONNX example: set COTH_HAY_SEEKER_EMBEDDINGS=local-onnx above.
# The directory must contain bundle.json plus every checksum-pinned artifact
# named by that manifest.
COTH_HAY_SEEKER_LOCAL_MODEL_DIR=
# Hand-staged static bundle. Setting this skips provisioning entirely and is
# what an air-gapped install uses. The directory contains static-bundle.json,
# model.safetensors, tokenizer.json, and config.json. Independent from ONNX.
COTH_HAY_SEEKER_LOCAL_STATIC_MODEL_DIR=
# Research-only override for checkpoints whose trained full width is not the
# product contract's default 768. The static retrieval candidate uses 1024.
# COTH_HAY_SEEKER_LOCAL_RESEARCH_ELASTICSEARCH_DIMENSIONS=1024
# Research-only DuckDB width for local ONNX bundles. The product contract is
# 256 MRL dimensions; override it to compare a local checkpoint against the same
# model on a hosted route at equal width, or to measure a checkpoint whose
# trained width is its only validated one. The bundle profile still rejects a
# width it never trained.
# COTH_HAY_SEEKER_LOCAL_RESEARCH_DUCKDB_DIMENSIONS=256

# Cloudflare AI Gateway Run token shared by the Gemini and OpenAI gateway
# routes. Do not put an upstream provider key here.
COTH_HAY_SEEKER_CF_AIG_TOKEN=

# Gemini example: set COTH_HAY_SEEKER_EMBEDDINGS=gemini.
COTH_HAY_SEEKER_GEMINI_MODEL_REVISION=
# Complete provider-native route:
# https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/google-vertex-ai/v1/projects/{project_id}/locations/{location}/publishers/google/models/gemini-embedding-2:embedContent
COTH_HAY_SEEKER_GEMINI_GATEWAY_URL=
COTH_HAY_SEEKER_GEMINI_EMBEDDING_DIMENSIONS=768
COTH_HAY_SEEKER_GEMINI_EMBEDDING_CONCURRENCY=8
COTH_HAY_SEEKER_GEMINI_EMBEDDING_MAX_ATTEMPTS=4
# Retrieval task named in Gemini Embedding 2's query prefix: search-result
# (default) or code-retrieval. The task travels in the query text, so changing
# it changes the embedding profile and requires a reindex.
# COTH_HAY_SEEKER_GEMINI_QUERY_TASK=search-result
COTH_HAY_SEEKER_GEMINI_SMOKE_CHUNK_TOKENS=1500

# OpenAI direct mode: leave COTH_HAY_SEEKER_OPENAI_GATEWAY_URL blank and set this key.
# Gateway mode: this key is optional with BYOK or Unified Billing.
COTH_HAY_SEEKER_OPENAI_API_KEY=
# Optional provider-native Cloudflare AI Gateway route. When set, also set
# COTH_HAY_SEEKER_CF_AIG_TOKEN above.
# https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/openai/embeddings
COTH_HAY_SEEKER_OPENAI_GATEWAY_URL=
COTH_HAY_SEEKER_OPENAI_MODEL_REVISION=
COTH_HAY_SEEKER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
COTH_HAY_SEEKER_OPENAI_EMBEDDING_DIMENSIONS=768
COTH_HAY_SEEKER_OPENAI_EMBEDDING_MAX_ATTEMPTS=4

# Voyage example: set COTH_HAY_SEEKER_EMBEDDINGS=voyage.
COTH_HAY_SEEKER_VOYAGE_TOKEN=
COTH_HAY_SEEKER_VOYAGE_MODEL_REVISION=
COTH_HAY_SEEKER_VOYAGE_EMBEDDING_MODEL=voyage-code-3
COTH_HAY_SEEKER_VOYAGE_EMBEDDING_DIMENSIONS=1024
COTH_HAY_SEEKER_VOYAGE_EMBEDDING_MAX_ATTEMPTS=4

# Workers AI embedding model: qwen3-embedding-0.6b (default, 1024d) or
# embeddinggemma-300m (768d). Each carries its own width and prompt contract
# into the manifest, so switching requires a reindex. An unverified name is
# refused rather than guessed.
# COTH_HAY_SEEKER_CLOUDFLARE_WORKERS_AI_MODEL=qwen3-embedding-0.6b

# Workers AI example: set
# COTH_HAY_SEEKER_EMBEDDINGS=cloudflare-workers-ai. The default model is
# Qwen3 Embedding 0.6B.
COTH_HAY_SEEKER_CLOUDFLARE_ACCOUNT_ID=
COTH_HAY_SEEKER_CLOUDFLARE_AI_TOKEN=
COTH_HAY_SEEKER_CLOUDFLARE_WORKERS_AI_MODEL_REVISION=
COTH_HAY_SEEKER_CLOUDFLARE_AI_MAX_ATTEMPTS=4

# Reranking reorders retrieved candidates with a cross-encoder. It reuses the
# Workers AI credentials above. The revision is required so a recorded ranking
# names the deployment that produced it; reranking is not part of the index
# manifest, so turning it on or off is never a reindex.
COTH_HAY_SEEKER_RERANK_MODEL_REVISION=
