# Copy this file to .env. Hay Seeker finds the nearest .env in the current
# directory or its parents. Exported process variables take precedence over
# this file, and command-line arguments take precedence over both.
#
# `hay-mcp` shares the backend, embedding, database, corpus, and Elasticsearch
# settings. Embedding choices are: none, local-onnx, local-static, gemini,
# open-ai, voyage, and cloudflare-workers-ai.
COTH_HAY_SEEKER_BACKEND=duckdb
# local-static is the zero-setup default: no credentials, and the pinned
# 31 MiB Potion Code 16M v2 bundle is provisioned on first use. Use none for
# lexical-only search.
COTH_HAY_SEEKER_EMBEDDINGS=local-static
COTH_HAY_SEEKER_DATABASE=.hay-seeker/index.duckdb
# Choose exactly one source for `hay index`:
# COTH_HAY_SEEKER_REPOSITORY=/absolute/path/to/repository
# COTH_HAY_SEEKER_CORPUS=evals/corpus.jsonl
# COTH_HAY_SEEKER_CHECKPOINT=.hay-seeker/index.checkpoint.json
COTH_HAY_SEEKER_STALL_TIMEOUT_SECONDS=600
COTH_HAY_SEEKER_PROGRESS_INTERVAL_SECONDS=5
COTH_HAY_SEEKER_ELASTICSEARCH_ENDPOINT=http://127.0.0.1:9200
COTH_HAY_SEEKER_ELASTICSEARCH_INDEX=hay-seeker
COTH_HAY_SEEKER_TOP_K=10
COTH_HAY_SEEKER_CANDIDATE_LIMIT=50
# COTH_HAY_SEEKER_QUERY=where is manifest compatibility validated?

# Automatic provisioning for local-static. Downloads are checksum-pinned, so a
# mirror can change where bytes come from but not which bytes are accepted.
# Set this to false for an air-gapped install; pair it with
# HAY_LOCAL_STATIC_MODEL_DIR below.
COTH_HAY_SEEKER_DOWNLOAD_MODELS=true
# Defaults to the per-user cache directory for this platform.
# COTH_HAY_SEEKER_MODEL_CACHE_DIR=
# Defaults to https://huggingface.co.
# COTH_HAY_SEEKER_MODEL_BASE_URL=

# Fully offline ONNX example: set COTH_HAY_SEEKER_EMBEDDINGS=local-onnx above.
# The directory must contain bundle.json plus every checksum-pinned artifact
# named by that manifest.
HAY_LOCAL_MODEL_DIR=
# Hand-staged static bundle. Setting this skips provisioning entirely and is
# what an air-gapped install uses. The directory contains static-bundle.json,
# model.safetensors, tokenizer.json, and config.json. Independent from ONNX.
HAY_LOCAL_STATIC_MODEL_DIR=
# Research-only override for checkpoints whose trained full width is not the
# product contract's default 768. The static retrieval candidate uses 1024.
# HAY_LOCAL_RESEARCH_ELASTICSEARCH_DIMENSIONS=1024

# Cloudflare AI Gateway Run token shared by the Gemini and OpenAI gateway
# routes. Do not put an upstream provider key here.
COTH_HAY_SEEKER_CF_AIG_TOKEN=

# Gemini example: set COTH_HAY_SEEKER_EMBEDDINGS=gemini.
GEMINI_MODEL_REVISION=
# Complete provider-native route:
# https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/google-vertex-ai/v1/projects/{project_id}/locations/{location}/publishers/google/models/gemini-embedding-2:embedContent
GEMINI_GATEWAY_URL=
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_CONCURRENCY=8
GEMINI_EMBEDDING_MAX_ATTEMPTS=4
GEMINI_SMOKE_CHUNK_TOKENS=1500

# OpenAI direct mode: leave OPENAI_GATEWAY_URL blank and set this key.
# Gateway mode: this key is optional with BYOK or Unified Billing.
COTH_HAY_SEEKER_OPENAI_API_KEY=
# Optional provider-native Cloudflare AI Gateway route. When set, also set
# COTH_HAY_SEEKER_CF_AIG_TOKEN above.
# https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/openai/embeddings
OPENAI_GATEWAY_URL=
OPENAI_MODEL_REVISION=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
OPENAI_EMBEDDING_MAX_ATTEMPTS=4

# Voyage example: set COTH_HAY_SEEKER_EMBEDDINGS=voyage.
VOYAGE_API_KEY=
VOYAGE_MODEL_REVISION=
VOYAGE_EMBEDDING_MODEL=voyage-code-3
VOYAGE_EMBEDDING_DIMENSIONS=1024
VOYAGE_EMBEDDING_MAX_ATTEMPTS=4

# Workers AI example: set
# COTH_HAY_SEEKER_EMBEDDINGS=cloudflare-workers-ai. The default model is
# Qwen3 Embedding 0.6B.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL_REVISION=
CLOUDFLARE_AI_MAX_ATTEMPTS=4
