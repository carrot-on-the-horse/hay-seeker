# Required only for fully offline ONNX embeddings. The directory must contain
# bundle.json plus every checksum-pinned artifact named by that manifest.
HAY_LOCAL_MODEL_DIR=
# Required only for the checksum-pinned code-specific static model. The
# directory contains static-bundle.json, model.safetensors, tokenizer.json,
# and config.json. This path is independent from the ONNX bundle above.
HAY_LOCAL_STATIC_MODEL_DIR=
# Research-only override for checkpoints whose trained full width is not the
# product contract's default 768. The static retrieval candidate uses 1024.
HAY_LOCAL_RESEARCH_ELASTICSEARCH_DIMENSIONS=

# Cloudflare AI Gateway Run token. Do not use a Google API key here.
CF_AIG_TOKEN=
GEMINI_MODEL_REVISION=
# Complete provider-native route:
# https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/google-vertex-ai/v1/projects/{project_id}/locations/{location}/publishers/google/models/gemini-embedding-2:embedContent
GEMINI_GATEWAY_URL=
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_CONCURRENCY=8
GEMINI_EMBEDDING_MAX_ATTEMPTS=4
GEMINI_SMOKE_CHUNK_TOKENS=1500

# Optional direct OpenAI embeddings provider.
OPENAI_API_KEY=
OPENAI_MODEL_REVISION=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
OPENAI_EMBEDDING_MAX_ATTEMPTS=4

# Optional Voyage code-embedding provider.
VOYAGE_API_KEY=
VOYAGE_MODEL_REVISION=
VOYAGE_EMBEDDING_MODEL=voyage-code-3
VOYAGE_EMBEDDING_DIMENSIONS=1024
VOYAGE_EMBEDDING_MAX_ATTEMPTS=4

# Optional Cloudflare Workers AI provider using Qwen3 Embedding 0.6B.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL_REVISION=
CLOUDFLARE_AI_MAX_ATTEMPTS=4
